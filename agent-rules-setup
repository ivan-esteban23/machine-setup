  git config --global --get gpg.ssh.allowedSignersFile >"$dir/git-allowed-signers" 2>/dev/null || :
  ok "git identity"

  if [[ "$SELF" != "$REPO_DIR/agent-rules-setup" ]]; then
    install -m 755 "$SELF" "$REPO_DIR/agent-rules-setup"
    ok "script copied into $REPO_DIR"
  fi

  printf '\nSnapshot written to %s\n\n' "$dir"
  printf 'Back these up separately — never commit them:\n'
  printf '  ~/.ssh/id_ed25519_signing        private signing key\n'
  printf '  ~/.codex/auth.json               Codex login\n'
  printf '  ~/.config/gh/hosts.yml           gh token\n'
  printf '  ~/.config/instaloader/session-*  Instagram session\n'
  printf '  ~/.secrets/github-token          local token copy\n'
  printf '  ~/.fcc/.env                      free-claude-code credentials\n'
  printf '  ~/.bashrc                        contains TAVILY_API_KEY\n'
  printf '  /etc/wireguard/wg-JP-446.conf    VPN private key (sudo)\n'
  printf '  ~/Downloads, ~/Work, ~/Documents/Obsidian Vault, ~/Pictures, ~/Videos\n'

  if (( PUSH )); then
    if [[ -d "$REPO_DIR/.git" ]]; then
      local paths=(agent-rules-setup snapshot)
      if [[ -f "$REPO_DIR/README.md" ]]; then
        paths+=(README.md)
      fi
      git -C "$REPO_DIR" add -- "${paths[@]}"
      if git -C "$REPO_DIR" diff --cached --quiet; then
        ok "snapshot unchanged; nothing to push"
      else
        git -C "$REPO_DIR" commit -m "snapshot: $(date +%F) machine state" >/dev/null
        if git -C "$REPO_DIR" push; then
          fix "snapshot committed and pushed"
        else
          drift "git push failed (snapshot is still local)"
        fi
      fi
    else
      note "$REPO_DIR is not a git repo; snapshot not pushed"
    fi
  fi
}


have_systemd() { systemctl --user show-environment >/dev/null 2>&1; }

if [[ "$ENABLE" -eq 1 ]] && have_systemd; then
  if [[ "$MODE" == "apply" ]]; then
    systemctl --user daemon-reload
    for t in "${TIMERS[@]}"; do
      case "$t" in
        pdm-clara-autodl.timer)      tc=$pdm_timer_changed ;;
        julie-autodl.timer)          tc=$julie_timer_changed ;;
        system-update-check.timer)   tc=$update_timer_changed ;;
        *)                           tc=0 ;;
      esac
      was="$(systemctl --user is-enabled "$t" 2>/dev/null || true)"
      if systemctl --user enable --now "$t" >/dev/null 2>&1; then
        if [[ "$tc" -eq 1 ]]; then
          systemctl --user try-restart "$t" >/dev/null 2>&1 || true
        fi
        if [[ "$was" == "enabled" ]]; then
          ok "$t enabled"
        else
          fix "$t enabled"
        fi
      else
        drift "$t could not be enabled"
      fi
    done
    for s in "${SERVICES[@]}"; do
      was="$(systemctl --user is-enabled "$s" 2>/dev/null || true)"
      if systemctl --user enable "$s" >/dev/null 2>&1; then
        if [[ "$was" == "enabled" ]]; then
          ok "$s enabled"
        else
          fix "$s enabled (starts at next login)"
        fi
      else
        drift "$s could not be enabled"
      fi
    done
    for p in "${WATCH_UNITS[@]}"; do
      was="$(systemctl --user is-enabled "$p" 2>/dev/null || true)"
      if systemctl --user enable --now "$p" >/dev/null 2>&1; then
        if [[ "$was" == "enabled" ]]; then
          ok "$p enabled"
        else
          fix "$p enabled"
        fi
      else
        drift "$p could not be enabled"
      fi
    done
  else
    for t in "${TIMERS[@]}"; do
      state="$(systemctl --user is-enabled "$t" 2>/dev/null || true)"
      active="$(systemctl --user is-active "$t" 2>/dev/null || true)"
      next="$(systemctl --user show -p NextElapseUSecRealtime --value "$t" 2>/dev/null || true)"
      if [[ "$state" == "enabled" && "$active" == "active" && -n "$next" && "$next" != "0" ]]; then
        ok "$t ($next)"
      else
        drift "$t (enabled=$state active=$active next=${next:-none})"
      fi
    done
    for s in "${SERVICES[@]}"; do
      state="$(systemctl --user is-enabled "$s" 2>/dev/null || true)"
      if [[ "$state" == "enabled" ]]; then
        ok "$s enabled"
      else
        drift "$s (enabled=$state)"
      fi
    done
    for p in "${WATCH_UNITS[@]}"; do
      state="$(systemctl --user is-enabled "$p" 2>/dev/null || true)"
      active="$(systemctl --user is-active "$p" 2>/dev/null || true)"
      if [[ "$state" == "enabled" && "$active" == "active" ]]; then
        ok "$p enabled"
      else
        drift "$p (enabled=$state active=$active)"
      fi
    done
  fi
else
  note "systemd user bus unavailable or --no-enable: timers not touched"
fi


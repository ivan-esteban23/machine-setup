import sys
import time
from pathlib import Path

import instaloader

USER = "ivan_esteban23"
TARGET = "pdm.clara"
DOWNLOAD_DIR = Path.home() / "Downloads"
DIR = DOWNLOAD_DIR / TARGET
SCAN_LIMIT = 36
MEDIA_SUFFIXES = {".jpg", ".jpeg", ".png", ".webp", ".mp4", ".mov"}


def main() -> int:
    L = instaloader.Instaloader(
        dirname_pattern=str(DOWNLOAD_DIR / "{profile}"),
        download_videos=False,
        save_metadata=True,

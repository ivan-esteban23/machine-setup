install_content "$BIN/download-monitor" 755 1 "download-monitor" <<'SH'
#!/usr/bin/env bash
# Live Instagram download monitor.
# Attaches to an active tmux download session; otherwise shows recent progress.

set -uo pipefail

get_sessions() {
    tmux ls -F '#{session_name}' 2>/dev/null | grep -E '^(ig-|instaloader)' | awk 'NF' || true
}

attach() {
    if [[ -n "${TMUX:-}" ]]; then
        exec tmux switch-client -t "$1"
    else
        exec tmux attach -t "$1"
    fi
}

show_dashboard() {
    printf 'Instagram download monitor — %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    printf 'No active download session.\n\nRecent progress:\n\n'
    shopt -s nullglob
    local logs=(~/Downloads/*.log)
    if (( ${#logs[@]} == 0 )); then
        printf '  (no download logs in ~/Downloads)\n'
        return
    fi
    local recent log last
    mapfile -t recent < <(ls -t "${logs[@]}" | head -4)
    for log in "${recent[@]}"; do
        printf -- '── %s\n' "$(basename "$log")"
        last=$(grep -aE '^\[[0-9]+/[0-9]+\]|^downloaded |^archive:|^cleanup:' "$log" 2>/dev/null | tail -1)
        printf '   %s\n\n' "${last:-no progress recorded}"
    done
}

if [[ "${1:-}" == "--logs" ]]; then
    show_dashboard
    exit 0
fi

mapfile -t sessions < <(get_sessions)

if (( ${#sessions[@]} == 1 )); then
    attach "${sessions[0]}"
elif (( ${#sessions[@]} > 1 )); then
    printf 'Active download sessions:\n'
    for i in "${!sessions[@]}"; do
        printf '  %d) %s\n' "$((i + 1))" "${sessions[$i]}"
    done
    read -r -p 'Attach to number (Ctrl+C to cancel): ' choice
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#sessions[@]} )); then
        attach "${sessions[$((choice - 1))]}"
    fi
    exit 1
fi

trap 'printf "\n"; exit 0' INT
while true; do
    clear
    show_dashboard
    printf 'No running session — refreshing every 5s. Ctrl+C to close.\n'
    sleep 5
done
SH


# -----------------------------------------------------------------------------
# 5. Codex config: keep read-only default, allow network for workspace-write
# -----------------------------------------------------------------------------
codex_config_patch() {
  local mode="$1"
  python3 - "$CODEX_CONFIG" "$mode" <<'PY'
import os
import re
import shutil
import sys
import tempfile

path, mode = sys.argv[1], sys.argv[2]
try:
    with open(path, encoding="utf-8") as fh:
        original = fh.read()
except FileNotFoundError:
    original = ""

def is_header(line):
    return line.lstrip().startswith("[")

def section_index(lines, name):
    pat = re.compile(r"^\s*\[" + re.escape(name) + r"\]\s*(?:#.*)?$")
    return next((i for i, line in enumerate(lines) if pat.match(line)), -1)

def next_section(lines, start):
    return next((i for i in range(start + 1, len(lines)) if is_header(lines[i])), len(lines))

def is_key(line, key):
    return re.match(r"^\s*" + re.escape(key) + r"\s*=", line) is not None

lines = original.splitlines()
notes = []

first = next((i for i, line in enumerate(lines) if is_header(line)), len(lines))
if not any(is_key(line, "sandbox_mode") for line in lines[:first]):
    lines.insert(first, 'sandbox_mode = "read-only"')
    notes.append("sandbox_mode read-only")

if any(re.match(r"^\s*sandbox_workspace_write\s*=", line) for line in lines):
    print("ERROR inline sandbox_workspace_write table; edit manually", file=sys.stderr)
    sys.exit(3)

idx = section_index(lines, "sandbox_workspace_write")
if idx == -1:
    if lines and lines[-1].strip():
        lines.append("")
    lines.extend([
        "# Added by agent-rules-setup: DNS/HTTPS for workspace-write sandboxes (codex-git)",
        "[sandbox_workspace_write]",
        "network_access = true",
    ])
    notes.append("network_access=true")
else:
    end = next_section(lines, idx)
    found = False
    for i in range(idx + 1, end):
        match = re.match(r"^(\s*)network_access\s*=\s*(true|false)(\s*(?:#.*)?)$", lines[i], re.I)
        if match:
            found = True
            if match.group(2).lower() != "true":
                lines[i] = f"{match.group(1)}network_access = true{match.group(3)}"
                notes.append("network_access=true")
            break
    if not found:
        lines.insert(idx + 1, "network_access = true")
        notes.append("network_access=true")

updated = "\n".join(lines).rstrip("\n") + "\n"
if updated == original:
    sys.exit(0)

if mode == "check":
    print("DRIFT " + (", ".join(notes) or "config"))
    sys.exit(4)

os.makedirs(os.path.dirname(path), exist_ok=True)
if original and not os.path.exists(path + ".bak-agent-rules"):
    shutil.copy2(path, path + ".bak-agent-rules")
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".config.toml.")
with os.fdopen(fd, "w", encoding="utf-8") as fh:
    fh.write(updated)
os.chmod(tmp, 0o600)
os.replace(tmp, path)
print("FIXED " + (", ".join(notes) or "config"))
sys.exit(10)
PY
}

if [[ "$MODE" == "check" ]]; then
  set +e
  out="$(codex_config_patch check 2>&1)"
  rc=$?
  set -e
  case "$rc" in
    0) ok "~/.codex/config.toml" ;;
    4) drift "~/.codex/config.toml ($out)" ;;
    *) drift "~/.codex/config.toml ($out)" ;;
  esac
else
  set +e
  out="$(codex_config_patch apply 2>&1)"
  rc=$?
  set -e
  case "$rc" in
    0) ok "~/.codex/config.toml" ;;
    10) fix "~/.codex/config.toml (${out#FIXED })" ;;
    3) drift "~/.codex/config.toml: $out" ;;
    *) drift "~/.codex/config.toml ($out)" ;;
  esac
fi

# -----------------------------------------------------------------------------
# Optional smoke test: real Codex sandbox, login shell, gh + git + signing
# -----------------------------------------------------------------------------
run_smoke() {
  command -v codex >/dev/null 2>&1 || { note "codex not installed; smoke skipped"; return 0; }
  [[ -x "$BIN/gh" ]] || { drift "smoke: $BIN/gh missing"; return 0; }

  local repo=""
  while IFS= read -r d; do repo="${d%/.git}"; break; done \
    < <(ls -d "$HOME_DIR"/Work/*/.git 2>/dev/null || true)
  [[ -n "$repo" ]] || repo="$HOME_DIR"

  local token
  token="$("$HOME_DIR/.local/share/mise/shims/gh" auth token 2>/dev/null || true)"
  [[ -n "$token" ]] || token="$(gh auth token 2>/dev/null || true)"

  printf '  smoke Codex sandbox (%s)...\n' "$repo"
  if (
    cd "$repo"
    GH_TOKEN="$token" codex sandbox \
      -c sandbox_mode="workspace-write" \
      -c sandbox_workspace_write.network_access=true \
      -c shell_environment_policy.inherit=all \
      -- bash -lc '
        set -e
        getent hosts github.com >/dev/null
        ~/.local/bin/gh auth status >/dev/null
        ~/.local/bin/gh api user --jq .login >/dev/null
        if git rev-parse --git-dir >/dev/null 2>&1 && git remote get-url origin >/dev/null 2>&1; then
          git ls-remote --heads origin >/dev/null
        fi
        tmp=$(mktemp -d)
        cd "$tmp" && git init -q r && cd r
        git -c user.name=smoke -c user.email=smoke@example.com commit -q --allow-empty -m smoke
        git log --show-signature -1 2>&1 | grep -q "Good \"git\" signature"
        cd / && rm -rf "$tmp"
      ' >/dev/null 2>&1
  ); then
    ok "smoke: DNS, gh auth/API, git fetch, SSH signing"
  else
    drift "smoke failed: DNS/gh/git/signing inside Codex sandbox"
  fi
}

if [[ "$SMOKE" -eq 1 ]]; then
  if [[ "$MODE" == "check" ]]; then
    note "--smoke ignored in --check mode"
  else
    run_smoke
  fi
fi

# -----------------------------------------------------------------------------
# Runtime checks (--check)
# -----------------------------------------------------------------------------
check_runtime() {
  local c
  for c in mise git tmux checkupdates python3 gh codex flock; do
    if command -v "$c" >/dev/null 2>&1; then
      ok "command: $c"
    else
      drift "command missing: $c"
    fi
  done
  if command -v uv >/dev/null 2>&1; then
    if command -v fcc-claude >/dev/null 2>&1; then
      ok "uv tool: free-claude-code"
    else
      note "uv tool missing: free-claude-code (uv tool install free-claude-code)"
    fi
  else
    note "uv missing (sidecar installer: curl -LsSf https://astral.sh/uv/install.sh | sh)"
  fi
  if command -v reason >/dev/null 2>&1; then
    ok "sidecar CLI: reason"
  else
    note "sidecar CLI missing: reason (install with its vendor installer)"
  fi
  if sudo_n test -f /etc/wireguard/wg-JP-446.conf 2>/dev/null; then
    ok "WireGuard config"
  else
    note "WireGuard config missing: restore /etc/wireguard/wg-JP-446.conf"
  fi
  if python3 -c 'import instaloader' >/dev/null 2>&1; then
    ok "python: instaloader"
  else
    drift "python: instaloader missing"
  fi
  if command -v notify-send >/dev/null 2>&1; then
    ok "notify-send"
  else
    note "notify-send missing (desktop notifications off)"
  fi
  if command -v mise >/dev/null 2>&1; then
    if mise which gh >/dev/null 2>&1; then
      ok "mise tool: gh"
    else
      drift "mise tool missing: gh"
    fi
    if mise which codex >/dev/null 2>&1; then
      ok "mise tool: codex"
    else
      drift "mise tool missing: codex"
    fi
  fi
  if gh auth status >/dev/null 2>&1; then
    ok "gh authenticated"
  else
    note "gh not authenticated (expected on a fresh restore)"
  fi
  if [[ -f "$CODEX_HOME/auth.json" ]]; then
    ok "codex authenticated"
  else
    note "codex not logged in (expected on a fresh restore)"
  fi
}

if [[ "$MODE" == "check" ]]; then
  check_runtime
fi


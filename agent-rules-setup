snapshot_obsidian() {
  local vault="$OBSIDIAN_VAULT" dir="$SNAPSHOT_DIR/obsidian"
  if [[ ! -d "$vault/.obsidian" ]]; then
    note "Obsidian vault not found at $vault; plugins not snapshotted"
    return 0
  fi
  mkdir -p "$dir/plugins"
  if [[ -f "$vault/.obsidian/community-plugins.json" ]]; then
    cp "$vault/.obsidian/community-plugins.json" "$dir/community-plugins.json"
  fi
  local plugin id count=0
  for plugin in "$vault/.obsidian/plugins"/*/; do
    [[ -f "$plugin/manifest.json" ]] || continue
    id="$(basename "$plugin")"
    mkdir -p "$dir/plugins/$id"
    cp -a "$plugin/." "$dir/plugins/$id/"
    if [[ -f "$plugin/data.json" ]] && has_secret "$plugin/data.json"; then
      rm -f "$dir/plugins/$id/data.json"
      note "Obsidian plugin $id: data.json has a token-like value; skipped"
    fi
    count=$((count + 1))
  done
  ok "Obsidian plugins: $count"
}

restore_obsidian() {
  local src="$SNAPSHOT_DIR/obsidian"
  [[ -d "$src/plugins" ]] || return 0
  if [[ ! -d "$OBSIDIAN_VAULT/.obsidian" ]]; then
    note "Obsidian vault missing; restore the vault, then rerun to install plugins"
    return 0
  fi
  local dest="$OBSIDIAN_VAULT/.obsidian/plugins"
  local plugin id count=0 missing_plugins=0
  mkdir -p "$dest"
  for plugin in "$src/plugins"/*/; do
    id="$(basename "$plugin")"
    if [[ -d "$dest/$id" ]]; then
      if [[ -f "$plugin/data.json" && ! -f "$dest/$id/data.json" ]]; then
        if [[ "$MODE" == "check" ]]; then
          drift "Obsidian plugin settings missing: $id"
        else
          cp -p "$plugin/data.json" "$dest/$id/data.json"
          fix "Obsidian plugin settings: $id"
        fi
      fi
      continue
    fi
    if [[ "$MODE" == "check" ]]; then
      drift "Obsidian plugin missing: $id"
      missing_plugins=$((missing_plugins + 1))
      continue
    fi
    cp -a "$plugin" "$dest/$id"
    count=$((count + 1))
    fix "Obsidian plugin: $id"
  done
  if (( count == 0 && missing_plugins == 0 )); then
    ok "Obsidian plugins"
  fi

  [[ -f "$src/community-plugins.json" ]] || return 0
  if [[ "$MODE" == "check" ]]; then
    return 0
  fi
  python3 - "$src/community-plugins.json" "$OBSIDIAN_VAULT/.obsidian/community-plugins.json" <<'PY'
import json, sys

src, dest = sys.argv[1], sys.argv[2]
try:
    with open(src, encoding="utf-8") as fh:
        wanted = json.load(fh)
except Exception:
    sys.exit(0)
try:
    with open(dest, encoding="utf-8") as fh:
        current = json.load(fh)
except Exception:
    current = []
if not isinstance(current, list):
    current = []
added = [p for p in wanted if p not in current]
if not added:
    sys.exit(0)
with open(dest, "w", encoding="utf-8") as fh:
    json.dump(current + added, fh, indent=2)
    fh.write("\n")
PY
}

git_set_if_empty() {
  local key="$1" val="$2"
  if [[ -z "$val" ]]; then
    return 0
  fi
  if [[ -n "$(git config --global --get "$key" 2>/dev/null || true)" ]]; then
    ok "git $key"
    return 0
  fi
  if [[ "$MODE" == "check" ]]; then
    drift "git $key not set"
    return 0
  fi
  git config --global "$key" "$val"
  fix "git $key"
}

bootstrap_git() {
  local name email skey sfmt sadd keyfile
  name=$(read_snap "$SNAPSHOT_DIR/git-user-name")
  email=$(read_snap "$SNAPSHOT_DIR/git-user-email")
  skey=$(read_snap "$SNAPSHOT_DIR/git-signing-key")
  sfmt=$(read_snap "$SNAPSHOT_DIR/git-signing-format")
  sadd=$(read_snap "$SNAPSHOT_DIR/git-allowed-signers")

  git_set_if_empty user.name "$name"
  git_set_if_empty user.email "$email"

  keyfile="$skey"
  if [[ -n "$keyfile" && ! -f "$keyfile" ]]; then
    keyfile="${skey%.pub}"
  fi
  if [[ -n "$skey" && -f "$keyfile" ]]; then
    local signing_value="$skey"
    if [[ ! -f "$signing_value" ]]; then
      signing_value="$keyfile"
    fi
    git_set_if_empty gpg.format "${sfmt:-ssh}"
    git_set_if_empty user.signingkey "$signing_value"
    git_set_if_empty gpg.ssh.allowedSignersFile "${sadd:-$HOME_DIR/.ssh/allowed_signers}"
    git_set_if_empty commit.gpgsign true
    git_set_if_empty tag.gpgsign true
    ok "commit signing configured"
  else
    note "private signing key missing (${skey:-~/.ssh/id_ed25519_signing}); signing left off"
    note "restore it from secure backup, then rerun --bootstrap (never commit it)"
    if [[ "$(git config --global --bool --get commit.gpgsign 2>/dev/null || true)" == "true" ]] \
      || [[ "$(git config --global --bool --get tag.gpgsign 2>/dev/null || true)" == "true" ]]; then
      if [[ "$MODE" == "check" ]]; then
        drift "git signing enabled without a private key"
      else
        git config --global commit.gpgsign false
        git config --global tag.gpgsign false
        fix "git signing disabled until the key is restored"
      fi
    fi
  fi

  if gh auth status >/dev/null 2>&1; then
    if [[ -n "$(git config --global --get-all credential.https://github.com.helper 2>/dev/null | tr -d '[:space:]')" ]]; then
      ok "git credential helper"
    elif gh auth setup-git >/dev/null 2>&1; then
      fix "git credential helper (gh)"
    else
      note "gh auth setup-git failed"
    fi
  else
    note "gh not authenticated: run 'gh auth login && gh auth setup-git' after bootstrap"
  fi
}

bootstrap_linger() {
  local linger
  linger=$(loginctl show-user "$USER" -p Linger 2>/dev/null || true)
  if [[ "$linger" == "Linger=yes" ]]; then
    ok "linger enabled"
    return 0
  fi
  if [[ "$MODE" == "check" ]]; then
    drift "linger disabled (timers stop at logout)"
    return 0
  fi
  if sudo_n loginctl enable-linger "$USER"; then
    fix "linger enabled"
  else
    drift "could not enable linger"
  fi
}

install_all_packages() {
  local exp="$SNAPSHOT_DIR/packages-explicit.txt" aur_file="$SNAPSHOT_DIR/packages-aur.txt"
  if [[ ! -s "$exp" ]]; then
    note "no explicit package snapshot; run --snapshot first"
    return 0
  fi

  local repo_list installed p
  local -a official=() aur=() skipped=() missing=()
  repo_list="$(mktemp)"
  installed="$(mktemp)"
  pacman -Ssq 2>/dev/null | sort -u >"$repo_list" || true
  pacman -Qq 2>/dev/null | sort -u >"$installed" || true

  if [[ -s "$aur_file" ]]; then
    mapfile -t aur <"$aur_file"
  fi
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    if [[ ${#aur[@]} -gt 0 ]] && printf '%s\n' "${aur[@]}" | grep -qxF "$p"; then
      continue
    fi
    if grep -qxF "$p" "$repo_list"; then
      official+=("$p")
    else
      skipped+=("$p")
    fi
  done <"$exp"

  if [[ "$MODE" == "check" ]]; then
    if (( ${#official[@]} + ${#aur[@]} == 0 )); then
      ok "packages: no snapshot entries"
      rm -f "$repo_list" "$installed"
      return 0
    fi
    mapfile -t missing < <(
      { printf '%s\n' "${official[@]}" "${aur[@]}"; } | sort -u | comm -23 - "$installed"
    )
    if (( ${#missing[@]} == 0 )); then
      ok "packages: ${#official[@]} repo + ${#aur[@]} AUR installed"
    else
      drift "packages missing: ${missing[*]}"
    fi
    rm -f "$repo_list" "$installed"
    return 0
  fi

  local failed=0
  if (( ${#official[@]} > 0 )); then
    if printf '%s\n' "${official[@]}" | xargs -r -n 50 sudo -n pacman -S --needed --noconfirm; then
      fix "repo packages installed (${#official[@]})"
    else
      drift "some repo packages failed (see pacman output)"
      failed=1
    fi
  fi
  if (( ${#aur[@]} > 0 )); then
    if ! command -v yay >/dev/null 2>&1; then
      note "yay missing; AUR packages skipped (${aur[*]})"
    elif yay -S --needed --noconfirm "${aur[@]}"; then
      fix "AUR packages installed (${#aur[@]})"
    else
      drift "some AUR packages failed (see yay output)"
      failed=1
    fi
  fi
  if (( ${#skipped[@]} > 0 )); then
    note "not in any configured repo: ${skipped[*]}"
  fi
  rm -f "$repo_list" "$installed"
  return "$failed"
}

bootstrap_packages() {
  install_all_packages
}


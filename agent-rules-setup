  if [[ -f "$HOME_DIR/.ssh/allowed_signers" ]]; then
    cp "$HOME_DIR/.ssh/allowed_signers" "$dir/allowed_signers"
    ok "SSH allowed signers"
  fi

  snapshot_configs
  snapshot_obsidian

  git config --global --get user.name >"$dir/git-user-name" 2>/dev/null || :
  git config --global --get user.email >"$dir/git-user-email" 2>/dev/null || :

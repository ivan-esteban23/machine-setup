#!/usr/bin/env bash
# shellcheck disable=SC2088
# ^ Labels quote ~/ paths for humans; they are never expanded.
# =============================================================================
# agent-rules-setup — provision and lint this machine's agent rules + fixes
#
# Idempotent. Run OUTSIDE the Codex sandbox (the sandbox cannot write $HOME).
#
# What this installs / repairs:
#   1. Rule files (written only when missing, or with --force)
#        ~/AGENTS.md                 autonomy / no-confirmation rules
#        ~/GEMINI.md                 same autonomy rules for Gemini CLI
#        ~/.gemini/config/AGENTS.md  same autonomy rules for Gemini CLI
#        ~/.qoder/AGENTS.md          Instagram, download monitoring, update
#                                    checks, account timers, Codex sandbox rules
#        ~/.codex/AGENTS.md          end-of-task GitHub sync rule
#   2. Tools in ~/.local/bin
#        ig-download           images-only Instagram archiver, metadata cleanup
#        download-monitor      tmux/log progress monitor for downloads
#        pdm-clara-autodl      hourly pdm.clara poller
#        system-update-check   pacman + AUR pending-update counter
#        codex-git             Codex with workspace-write + network + GH_TOKEN
#        gh                    fixed wrapper: falls back to the mise shim when
#                              the filesystem is read-only (Codex sandbox)
#        obsidian              CLI bridge to Obsidian's Unix socket
#        wireguard-jp-toggle   SUPER+SHIFT+V VPN toggle (wg-quick@wg-JP-446)
#        claude, codex, gemini, grok, copilot, crush, opencode, opencode,
#        pi, muse, cursor-agent, hunk, omp, ghui, playwright
#                              mise-run wrappers (auto-install on first use)
#   3. systemd --user timers and remote-control services
#        pdm-clara-autodl.timer     hourly, RemainAfterElapse=no
#        julie-autodl.timer         hourly, RemainAfterElapse=no   (fixed)
#        system-update-check.timer  every 3h, calendar-based       (fixed)
#        codex-remote-control.service   Codex mobile/browser access
#        qoder-remote-control.service   Qoder mobile/browser access
#        gh-wrapper-watch.path          restores the gh wrapper when
#                                       omarchy-refresh-applications rewrites it
#      The old OnBootSec/OnUnitActiveSec pair can wedge at next_elapse=0
#      after a failed run; OnCalendar + RemainAfterElapse=no cannot.
#   4. ~/.codex/config.toml
#        sandbox_mode stays "read-only"; [sandbox_workspace_write] gets
#        network_access = true so codex-git and PR work have DNS + HTTPS.
#   5. Snapshot-managed personal config (copied only when missing)
#        git aliases/ignore, starship, alacritty, Hypr bindings, Omarchy bar,
#        fcitx5 profile + systemd drop-in, GTK_IM_MODULE, Obsidian vault
#        registry, VS Code settings, Qoder settings, Claude theme
#   6. Omarchy extras
#        Tailscale feature: tailscaled, operator, Taildrop receive service,
#        bar plugin (browser auth stays manual; admin web app via Omarchy menu)
#        Qoder CLI and Antigravity CLI installed with their official installers
#        Every explicit pacman + AUR package from the snapshot (--install-packages)
#   7. Obsidian community plugins
#        snapshot/obsidian/ holds all plugin files + settings; missing plugin
#        folders are restored and enabled in community-plugins.json
#
# Why Codex used to block PR completion:
#   * default read-only sandbox has no DNS/network -> gh and git push fail
#   * no GH_TOKEN inside the sandbox -> gh treats the keyring token as invalid
#   * login shells re-prepend ~/.local/bin, so `gh` hit the auto-update wrapper,
#     which runs `mise use -g` and exits on the read-only filesystem
#   Fixes: codex-git (workspace-write + network + GH_TOKEN + mise shims) and
#   the gh wrapper's read-only fallback. SSH commit signing works in-sandbox.
#
# Usage:
#   agent-rules-setup                 apply everything (safe to re-run)
#   agent-rules-setup --check         report drift only, change nothing (exit 1)
#   agent-rules-setup --lint          bash -n + shellcheck (warnings) on this script
#   agent-rules-setup --repair-gh     reinstall just the gh wrapper (watch unit)
#   agent-rules-setup --force         also overwrite the AGENTS.md / GEMINI.md files
#   agent-rules-setup --no-enable     install files but do not touch systemd
#   agent-rules-setup --smoke         after applying, run a real sandbox git/gh test
#   agent-rules-setup --ssh-key=F     authorize public key F, then require key auth
#   agent-rules-setup --restore-guide print the full reinstall/restore runbook
#   agent-rules-setup --pre-reset     snapshot + push, then print the wipe checklist
#   agent-rules-setup --install-packages  reinstall every snapshotted pacman + AUR package
#
# Recovery on a fresh Omarchy install (mise is part of Omarchy; it is not
# reinstalled here):
#   mise use -g gh
#   gh auth login
#   mkdir -p ~/Work
#   gh repo clone ivan-esteban23/machine-setup ~/Work/machine-setup
#   cd ~/Work/machine-setup
#   ./agent-rules-setup --bootstrap                 deps + tools + configs + apply
#   ./agent-rules-setup --bootstrap --minimal       only gh + codex (skip full mise set)
#   ./agent-rules-setup --bootstrap --with-packages reinstall the snapshotted
#                                                   pacman/AUR package lists too
#   ./agent-rules-setup --snapshot                  refresh snapshot/ from this machine
#   ./agent-rules-setup --snapshot --push           snapshot, commit, and push the repo
#
# Omarchy Tailscale feature (also run by --bootstrap):
#   tailscaled enabled, Taildrop receive service, bar plugin.
#   One manual step remains: sudo tailscale up --accept-routes (browser login).
#
# SSH access (also run on every apply/check):
#   openssh installed, sshd enabled, and `ufw limit 22/tcp` staged. The firewall
#   is never enabled here: qBittorrent listens on the LAN (16581) and default-deny
#   would cut it off. Password auth is disabled only once ~/.ssh/authorized_keys
#   holds a key and is reverted if the file empties, so hardening can never lock
#   the phone out. Add the phone's key first: --ssh-key=<file.pub>.
#
# NOT included (never commit these; restore from a secure backup):
#   ~/.ssh/id_ed25519_signing         private signing key
#   ~/.codex/auth.json                Codex login
#   ~/.config/gh/hosts.yml            gh token
#   ~/.config/instaloader/session-*   Instagram session
#   ~/.secrets/github-token           local token copy
#   ~/.fcc/.env                       free-claude-code credentials
#   ~/.bashrc                         contains TAVILY_API_KEY
#   /etc/wireguard/wg-JP-446.conf     VPN private key (root-owned)
#   ~/Downloads, ~/Work, ~/{Documents/Obsidian Vault,Pictures,Videos}
# After restoring, log in again: gh auth login && gh auth setup-git; codex login;
# log into instagram.com in Firefox and run ig-download ... --cookies firefox.
# =============================================================================

set -euo pipefail

MODE="apply"
FORCE=0
ENABLE=1
SMOKE=0
BOOTSTRAP=0
WITH_PACKAGES=0
MINIMAL=0
SNAPSHOT_MODE=0
PUSH=0
RESTORE_GUIDE=0
PRE_RESET=0
PACKAGES_ONLY=0
LINT=0
REPAIR_GH=0
SSH_KEY=""

usage() {
  awk 'f && /^# ={20,}$/ {exit} /^# Usage:/{f=1} f {sub(/^# ?/, ""); print}' "$0"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check)          MODE="check"; shift ;;
    --apply)          MODE="apply"; shift ;;
    --force)          FORCE=1; shift ;;
    --no-enable)      ENABLE=0; shift ;;
    --smoke)          SMOKE=1; shift ;;
    --bootstrap)      BOOTSTRAP=1; shift ;;
    --with-packages)  WITH_PACKAGES=1; shift ;;
    --minimal)        MINIMAL=1; shift ;;
    --snapshot)       SNAPSHOT_MODE=1; shift ;;
    --push)           PUSH=1; shift ;;
    --restore-guide)  RESTORE_GUIDE=1; shift ;;
    --pre-reset)      PRE_RESET=1; SNAPSHOT_MODE=1; PUSH=1; shift ;;
    --install-packages) PACKAGES_ONLY=1; shift ;;
    --lint)           LINT=1; shift ;;
    --repair-gh)      REPAIR_GH=1; shift ;;
    --ssh-key=*)      SSH_KEY="${1#*=}"; shift ;;
    --ssh-key)        SSH_KEY="${2:?--ssh-key needs a file}"; shift 2 ;;
    -h|--help)        usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done

HOME_DIR="${HOME:?HOME is not set}"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd "$(dirname "$SELF")" && pwd)"
# The installed copy in ~/.local/bin should still snapshot into the checkout.
if [[ ! -d "$REPO_DIR/.git" && -d "$HOME_DIR/Work/machine-setup/.git" ]]; then
  REPO_DIR="$HOME_DIR/Work/machine-setup"
fi
SNAPSHOT_DIR="$REPO_DIR/snapshot"
BIN="$HOME_DIR/.local/bin"
UNIT_DIR="$HOME_DIR/.config/systemd/user"
CODEX_HOME="${CODEX_HOME:-$HOME_DIR/.codex}"
CODEX_CONFIG="$CODEX_HOME/config.toml"
OBSIDIAN_VAULT="${OBSIDIAN_VAULT:-$HOME_DIR/Documents/Obsidian Vault}"
TIMERS=(pdm-clara-autodl.timer julie-autodl.timer system-update-check.timer)
SERVICES=(codex-remote-control.service qoder-remote-control.service)
WATCH_UNITS=(gh-wrapper-watch.path)

changes=0
problems=0
LAST_CHANGED=0

ok()    { printf '  ok    %s\n' "$*"; }
fix()   { printf '  fix   %s\n' "$*"; changes=$((changes + 1)); }
drift() { printf '  drift %s\n' "$*"; problems=$((problems + 1)); }
note()  { printf '  note  %s\n' "$*"; }
die()   { printf 'error: %s\n' "$*" >&2; exit 1; }

if [[ "$LINT" -eq 1 ]]; then
  rc=0
  bash -n "$SELF" || rc=1
  if command -v shellcheck >/dev/null 2>&1; then
    shellcheck -x -S warning "$SELF" || rc=1
  else
    note "shellcheck not installed; ran bash -n only"
  fi
  exit "$rc"
fi

# install_content PATH MODE FORCE_OK LABEL  (content on stdin)
install_content() {
  local path="$1" mode="$2" force_ok="$3" label="$4"
  local tmp
  LAST_CHANGED=0
  tmp="$(mktemp)"
  cat >"$tmp"

  if [[ -f "$path" ]] && cmp -s "$tmp" "$path"; then
    chmod "$mode" "$path" 2>/dev/null || true
    ok "$label"
    rm -f "$tmp"
    return 0
  fi

  if [[ "$MODE" == "check" ]]; then
    if [[ -f "$path" ]]; then
      drift "$label (out of date)"
    else
      drift "$label (missing)"
    fi
    rm -f "$tmp"
    return 0
  fi

  if [[ -f "$path" && "$force_ok" -ne 1 ]]; then
    note "$label (exists, left untouched; --force to overwrite)"
    rm -f "$tmp"
    return 0
  fi

  mkdir -p "$(dirname "$path")"
  if [[ -f "$path" && ! -e "$path.bak-agent-rules" ]]; then
    cp -p "$path" "$path.bak-agent-rules"
  fi
  install -m "$mode" "$tmp" "$path"
  LAST_CHANGED=1
  fix "$label"
  rm -f "$tmp"
}

install_self() {
  if [[ "$SELF" == "$BIN/agent-rules-setup" ]]; then
    ok "agent-rules-setup"
    return 0
  fi
  install_content "$BIN/agent-rules-setup" 755 1 "agent-rules-setup" <"$SELF"
}

install_gh_wrapper() {
  install_content "$BIN/gh" 755 1 "gh (read-only fallback)" <<'SH'
#!/bin/bash
export MISE_MINIMUM_RELEASE_AGE=0
if mise use -g --quiet "gh" 2>/dev/null; then
  exec mise x "gh" -- "gh" "$@"
fi
# Read-only sandbox (/home is not writable): `mise use` cannot rewrite config.
# Fall back to the already-installed shim so gh/git credential/PR work works.
shim="$HOME/.local/share/mise/shims/gh"
if [ -x "$shim" ]; then
  exec "$shim" "$@"
fi
echo "gh: mise could not update and no mise shim exists" >&2
exit 1
SH

  if [[ "$MODE" == "check" && -f "$BIN/gh" ]] && ! grep -q 'Read-only sandbox' "$BIN/gh"; then
    note "omarchy-refresh-applications rewrites $BIN/gh; rerun this script after refreshing"
  fi
}

if [[ "$REPAIR_GH" -eq 1 ]]; then
  MODE="apply"
  install_gh_wrapper
  exit 0
fi

# -----------------------------------------------------------------------------
# Recovery helpers — Omarchy ships mise in the base image, so it is assumed
# -----------------------------------------------------------------------------
sudo_n() { sudo -n "$@"; }

ensure_pkgs() {
  local missing=() p
  for p in "$@"; do
    if ! pacman -Q "$p" >/dev/null 2>&1; then
      missing+=("$p")
    fi
  done
  if (( ${#missing[@]} == 0 )); then
    ok "packages: $*"
    return 0
  fi
  if [[ "$MODE" == "check" ]]; then
    drift "packages missing: ${missing[*]}"
    return 0
  fi
  if ! command -v pacman >/dev/null 2>&1; then
    die "pacman not found; this recovery kit targets Omarchy/Arch"
  fi
  if sudo_n pacman -S --needed --noconfirm "${missing[@]}"; then
    fix "packages installed: ${missing[*]}"
  else
    drift "package install failed: ${missing[*]}"
  fi
}

ensure_aur() {
  local p
  for p in "$@"; do
    if pacman -Q "$p" >/dev/null 2>&1; then
      ok "AUR package: $p"
      continue
    fi
    if [[ "$MODE" == "check" ]]; then
      drift "AUR package missing: $p"
      continue
    fi
    if ! command -v yay >/dev/null 2>&1; then
      drift "yay missing; cannot install $p"
      continue
    fi
    if yay -S --needed --noconfirm "$p"; then
      fix "AUR package installed: $p"
    else
      drift "AUR install failed: $p"
    fi
  done
}

backup_once() {
  local dest="$1"
  if [[ -f "$dest" && ! -e "$dest.bak-agent-rules" ]]; then
    cp -p "$dest" "$dest.bak-agent-rules"
  fi
}

restore_file() {
  local src="$1" dest="$2" mode="$3" label="$4"
  if [[ ! -f "$src" ]]; then
    return 0
  fi
  if [[ -f "$dest" ]] && cmp -s "$src" "$dest"; then
    ok "$label"
    return 0
  fi
  if [[ "$MODE" == "check" ]]; then
    ok "$label"
    return 0
  fi
  mkdir -p "$(dirname "$dest")"
  backup_once "$dest"
  install -m "$mode" "$src" "$dest"
  fix "$label"
}

# Personal config restored on a fresh machine, never overwritten afterwards.
CONFIG_MANIFEST=(
  ".config/git/config"
  ".config/git/ignore"
  ".config/starship.toml"
  ".config/alacritty/alacritty.toml"
  ".config/hypr/autostart.lua"
  ".config/hypr/bindings.lua"
  ".config/hypr/hyprland.lua"
  ".config/hypr/hyprsunset.conf"
  ".config/hypr/input.lua"
  ".config/hypr/looknfeel.lua"
  ".config/hypr/monitors.lua"
  ".config/hypr/xdph.conf"
  ".config/omarchy/shell.json"
  ".config/omarchy/defaults/agent"
  ".config/environment.d/20-fcitx-gtk.conf"
  ".config/systemd/user/omarchy-fcitx5.service.d/override.conf"
  ".config/fcitx5/profile"
  ".config/fcitx5/conf/classicui.conf"
  ".config/fcitx5/conf/clipboard.conf"
  ".config/fcitx5/conf/hangul.conf"
  ".config/fcitx5/conf/notifications.conf"
  ".config/fcitx5/conf/xcb.conf"
  ".config/obsidian/obsidian.json"
  ".config/Code/User/settings.json"
  ".qoder/settings.json"
  ".claude/settings.json"
)

has_secret() {
  grep -qE 'gh[pousr]_[A-Za-z0-9]{20,}|github_pat_|sk-[A-Za-z0-9]{20,}|AIza[0-9A-Za-z_-]{20,}|xox[baprs]-|tvly-[A-Za-z0-9_-]{10,}|BEGIN [A-Z ]*PRIVATE KEY' "$1"
}

snapshot_configs() {
  local dir="$SNAPSHOT_DIR/config" rel src count=0
  local skipped=()
  mkdir -p "$dir"
  for rel in "${CONFIG_MANIFEST[@]}"; do
    src="$HOME_DIR/$rel"
    [[ -f "$src" ]] || continue
    if has_secret "$src"; then
      skipped+=("$rel")
      continue
    fi
    mkdir -p "$dir/$(dirname "$rel")"
    cp -p "$src" "$dir/$rel"
    count=$((count + 1))
  done
  ok "personal config: $count files"
  if (( ${#skipped[@]} > 0 )); then
    note "config with token-like values skipped: ${skipped[*]}"
  fi
}

restore_configs() {
  local rel src dest
  for rel in "${CONFIG_MANIFEST[@]}"; do
    src="$SNAPSHOT_DIR/config/$rel"
    [[ -f "$src" ]] || continue
    dest="$HOME_DIR/$rel"
    if [[ -f "$dest" ]]; then
      ok "config: $rel"
      continue
    fi
    if [[ "$MODE" == "check" ]]; then
      drift "config missing: $rel"
      continue
    fi
    mkdir -p "$(dirname "$dest")"
    install -m "$(stat -c %a "$src")" "$src" "$dest"
    fix "config: $rel"
  done
}

install_mise_wrapper() {
  local cmd="$1" spec="$2"
  install_content "$BIN/$cmd" 755 1 "mise wrapper: $cmd" <<EOF
#!/bin/bash
export MISE_MINIMUM_RELEASE_AGE=0
mise use -g --quiet "$spec" || exit 1
exec mise x "$spec" -- "$cmd" "\$@"
EOF
}

read_snap() {
  if [[ -s "$1" ]]; then
    head -1 "$1"
  fi
}

ensure_path_block() {
  local file="$1"
  if [[ -f "$file" ]] && grep -q '# >>> agent-rules PATH >>>' "$file"; then
    ok "PATH block: $file"
    return 0
  fi
  if [[ "$MODE" == "check" ]]; then
    drift "PATH block missing: $file"
    return 0
  fi
  mkdir -p "$(dirname "$file")"
  touch "$file"
  cat >>"$file" <<'EOF'

# >>> agent-rules PATH >>>
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac
# <<< agent-rules PATH <<<
EOF
  fix "PATH block: $file"
}

bootstrap_mise() {
  if ! command -v mise >/dev/null 2>&1; then
    die "mise not found; a fresh Omarchy install provides it (pacman -S mise-bin)"
  fi
  if (( MINIMAL )); then
    if MISE_YES=1 mise use -g gh@latest codex@latest; then
      fix "mise tools: gh, codex"
    else
      drift "mise tools: gh, codex"
    fi
    mise reshim >/dev/null 2>&1 || true
    return 0
  fi
  restore_file "$SNAPSHOT_DIR/mise-config.toml" "$HOME_DIR/.config/mise/config.toml" 644 "mise config"
  if MISE_YES=1 mise install; then
    fix "mise install"
  else
    drift "mise install (some tools failed)"
  fi
  mise reshim >/dev/null 2>&1 || true
}

bootstrap_configs() {
  restore_configs
  restore_file "$SNAPSHOT_DIR/codex-config.toml" "$CODEX_HOME/config.toml" 600 "codex config"
  restore_file "$SNAPSHOT_DIR/allowed_signers" "$HOME_DIR/.ssh/allowed_signers" 644 "SSH allowed signers"
}

bootstrap_uv_tool() {
  if command -v fcc-claude >/dev/null 2>&1; then
    ok "uv tool: free-claude-code"
    return 0
  fi
  if ! command -v uv >/dev/null 2>&1; then
    note "uv missing; reinstall it first (curl -LsSf https://astral.sh/uv/install.sh | sh)"
    note "then: uv tool install free-claude-code"
    return 0
  fi
  if [[ "$MODE" == "check" ]]; then
    drift "uv tool missing: free-claude-code"
    return 0
  fi
  if uv tool install free-claude-code; then
    fix "uv tool: free-claude-code"
  else
    drift "uv tool install failed: free-claude-code"
  fi
}

bootstrap_tailscale() {
  if ! command -v tailscale >/dev/null 2>&1; then
    if [[ "$MODE" == "check" ]]; then
      drift "tailscale missing (Omarchy feature)"
      return 0
    fi
    if sudo_n pacman -S --needed --noconfirm tailscale; then
      fix "tailscale installed"
    else
      drift "tailscale install failed"
      return 0
    fi
  else
    ok "tailscale package"
  fi

  if systemctl is-enabled --quiet tailscaled.service 2>/dev/null \
    && systemctl is-active --quiet tailscaled.service 2>/dev/null; then
    ok "tailscaled"
  elif [[ "$MODE" == "check" ]]; then
    drift "tailscaled not enabled/active"
  else
    if sudo_n systemctl enable --now tailscaled.service; then
      fix "tailscaled enabled"
    else
      drift "tailscaled could not be enabled"
    fi
  fi

  if systemctl --user is-enabled --quiet omarchy-tailscale-receive.service 2>/dev/null; then
    ok "Taildrop receive service"
  elif [[ "$MODE" == "check" ]]; then
    drift "Taildrop receive service disabled"
  else
    if systemctl --user enable --now omarchy-tailscale-receive.service 2>/dev/null; then
      fix "Taildrop receive service enabled"
    else
      note "omarchy-tailscale-receive.service unavailable"
    fi
  fi

  if command -v omarchy-plugin-enable >/dev/null 2>&1; then
    if jq -e '[.bar.layout[]?[]? | if type == "object" then .id else . end]
              | index("omarchy.tailscale")' \
      "$HOME_DIR/.config/omarchy/shell.json" >/dev/null 2>&1; then
      ok "Omarchy Tailscale bar plugin"
    elif [[ "$MODE" == "check" ]]; then
      drift "Omarchy Tailscale bar plugin disabled"
    else
      # The shell IPC occasionally exceeds its 2s timeout; one retry fixes it.
      if omarchy-plugin-enable omarchy.tailscale >/dev/null 2>&1 \
        || { sleep 2; omarchy-plugin-enable omarchy.tailscale >/dev/null 2>&1; }; then
        fix "Omarchy Tailscale bar plugin enabled"
      else
        note "could not enable the Omarchy Tailscale bar plugin"
      fi
    fi
  fi

  if systemctl is-active --quiet tailscaled.service 2>/dev/null; then
    if sudo_n tailscale set --operator="$USER" >/dev/null 2>&1; then
      ok "tailscale operator"
    else
      note "could not set the Tailscale operator"
    fi
    if tailscale status >/dev/null 2>&1; then
      ok "tailscale logged in"
    else
      note "Tailscale not logged in: run 'sudo tailscale up --accept-routes'"
    fi
  fi
}

bootstrap_ssh() {
  local conf="/etc/ssh/sshd_config.d/10-omarchy-hardening.conf"
  local ak="$HOME_DIR/.ssh/authorized_keys"
  local line body want have_key=0

  ensure_pkgs openssh

  if systemctl is-enabled --quiet sshd.service 2>/dev/null \
    && systemctl is-active --quiet sshd.service 2>/dev/null; then
    ok "sshd"
  elif [[ "$MODE" == "check" ]]; then
    drift "sshd not enabled/active"
  elif sudo_n systemctl enable --now sshd.service; then
    fix "sshd enabled"
  else
    drift "sshd could not be enabled"
  fi

  # Stage the rule only: ufw stays inactive because the LAN services
  # (qBittorrent on 16581) are reachable through it.
  if command -v ufw >/dev/null 2>&1; then
    if sudo_n ufw show added 2>/dev/null | grep -q '^ufw limit 22/tcp'; then
      ok "ufw rule: limit 22/tcp (staged)"
    elif [[ "$MODE" == "check" ]]; then
      drift "ufw rule missing: limit 22/tcp"
    elif sudo_n ufw limit 22/tcp comment "omarchy-sshd" >/dev/null 2>&1; then
      fix "ufw rule staged: limit 22/tcp"
    else
      drift "could not stage ufw rule: limit 22/tcp"
    fi
    if sudo_n ufw status 2>/dev/null | grep -q '^Status: inactive'; then
      note "ufw inactive; enabling it needs allow rules for qBittorrent (16581)"
    fi
  else
    note "ufw not installed; SSH rate limit not staged"
  fi

  if [[ -n "$SSH_KEY" ]]; then
    if [[ ! -r "$SSH_KEY" ]]; then
      drift "ssh key unreadable: $SSH_KEY"
    elif ! line="$(awk 'NF >= 2 && $1 !~ /^#/ {print; exit}' "$SSH_KEY")" \
      || ! body="$(awk '{print $2}' <<<"$line")" \
      || [[ -z "$body" ]] || ! ssh-keygen -lf <(printf '%s\n' "$line") >/dev/null 2>&1; then
      drift "not a usable SSH public key: $SSH_KEY"
    elif [[ -f "$ak" ]] && grep -qF -- "$body" "$ak"; then
      ok "ssh authorized key: $SSH_KEY"
    elif [[ "$MODE" == "check" ]]; then
      drift "ssh key not authorized: $SSH_KEY"
    else
      mkdir -p "$HOME_DIR/.ssh"
      chmod 700 "$HOME_DIR/.ssh"
      touch "$ak"
      chmod 600 "$ak"
      printf '%s\n' "$line" >>"$ak"
      fix "ssh authorized key: $SSH_KEY"
    fi
  fi

  if [[ -s "$ak" ]] && grep -qvE '^[[:space:]]*(#|$)' "$ak"; then
    have_key=1
  fi

  if (( ! have_key )); then
    note "no authorized SSH key; password auth stays on"
    if [[ -f "$conf" ]]; then
      if [[ "$MODE" == "check" ]]; then
        drift "sshd key-only hardening without an authorized key (lockout risk)"
      else
        sudo_n rm -f "$conf"
        sudo_n systemctl reload sshd.service 2>/dev/null || true
        fix "sshd hardening reverted (no authorized key)"
      fi
    fi
    return 0
  fi

  want=$'PasswordAuthentication no\nKbdInteractiveAuthentication no'
  # Capture once: `grep -q` closes the pipe early and pipefail would report
  # sshd's SIGPIPE as a failure. sshd -T also prints mixed-case key names.
  local eff
  eff="$(sudo_n sshd -T 2>/dev/null || true)"
  if grep -qix 'passwordauthentication no' <<<"$eff" \
    && grep -qix 'kbdinteractiveauthentication no' <<<"$eff"; then
    ok "sshd: key-only auth"
    return 0
  fi
  if [[ "$MODE" == "check" ]]; then
    drift "sshd password auth still enabled (authorized key present)"
    return 0
  fi

  local tmp
  tmp="$(mktemp)"
  printf '%s\n' "$want" >"$tmp"
  if [[ -f "$conf" && ! -e "$conf.bak-agent-rules" ]]; then
    sudo_n cp -p "$conf" "$conf.bak-agent-rules"
  fi
  if sudo_n install -m 644 "$tmp" "$conf" && sudo_n sshd -t && sudo_n sshd -T >/dev/null; then
    rm -f "$tmp"
    if sudo_n systemctl reload sshd.service; then
      fix "sshd: key-only auth"
    else
      drift "sshd reload failed"
    fi
  else
    rm -f "$tmp"
    if [[ -e "$conf.bak-agent-rules" ]]; then
      sudo_n cp -p "$conf.bak-agent-rules" "$conf"
    else
      sudo_n rm -f "$conf"
    fi
    sudo_n systemctl reload sshd.service 2>/dev/null || true
    drift "sshd rejected the hardening drop-in; password auth left on"
  fi
}

